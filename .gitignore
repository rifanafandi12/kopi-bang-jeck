# FOLDER DEPENDENSI (Jangan di-commit)
/node_modules
/public/build
/public/hot
/public/storage
/vendor
/storage/*.key
/storage/pail

# FILE KONFIGURASI & RAHASIA
.env
.env.backup
.env.production
.env.local
.env.development

# FILE LOG & CACHE
/.phpunit.cache
/.phpunit.result.cache
.phpunit.result.cache
.phpunit.cache
/tmp
auth.json
npm-debug.log
yarn-error.log
/.idea
/.vscode
/.fleet
/.nova
/.zed
.DS_Store
Thumbs.db

# DATABASE LOKAL (Jika menggunakan SQLite)
/database/*.sqlite
/database/*.sqlite-journal

# FILE UPLOAD / STORAGE LOKAL
# (Mencegah gambar yang diupload admin ikut ter-commit)
/storage/app/public/*
!/storage/app/public/.gitignore
/public/uploads
